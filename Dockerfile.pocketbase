# Standalone PocketBase service for Liara.
# Deploy as a separate service; never replace the existing Node app.
ARG POCKETBASE_VERSION=0.42.1
ARG TARGETARCH=amd64
FROM alpine:3.23
ARG POCKETBASE_VERSION
ARG TARGETARCH
RUN apk add --no-cache ca-certificates unzip wget \
  && wget -O /tmp/pocketbase.zip "https://ganigeorgiev.com/meta/pocketbase/pocketbase/download/v${POCKETBASE_VERSION}/pocketbase_${POCKETBASE_VERSION}_linux_${TARGETARCH}.zip" \
  && unzip /tmp/pocketbase.zip -d /pb \
  && rm /tmp/pocketbase.zip \
  && chmod +x /pb/pocketbase
WORKDIR /pb
COPY pb_migrations /pb/pb_migrations
RUN mkdir -p /pb/pb_data
EXPOSE 8090
VOLUME ["/pb/pb_data"]
ENV POCKETBASE_ALLOWED_ORIGINS=https://carplus.liara.run
CMD ["/bin/sh", "-c", "exec /pb/pocketbase serve --http=0.0.0.0:8090 --origins=${POCKETBASE_ALLOWED_ORIGINS}"]
