# Standalone PocketBase service for Liara.
# Deploy this file as the Dockerfile for a separate service; do not replace the Node app.
ARG POCKETBASE_VERSION=0.42.1
FROM golang:1.27-alpine AS pocketbase-build
RUN apk add --no-cache git ca-certificates
ARG POCKETBASE_VERSION
ENV CGO_ENABLED=0
RUN go install "ganigeorgiev.com/pocketbase/pocketbase/examples/base@v${POCKETBASE_VERSION}"

FROM alpine:3.23
RUN apk add --no-cache ca-certificates
WORKDIR /pb
COPY --from=pocketbase-build /go/bin/base /pb/pocketbase
COPY pb_migrations /pb/pb_migrations
RUN mkdir -p /pb/pb_data
EXPOSE 8090
VOLUME ["/pb/pb_data"]
ENV POCKETBASE_ALLOWED_ORIGINS=https://carplus.liara.run
CMD ["/bin/sh", "-c", "exec /pb/pocketbase serve --http=0.0.0.0:8090 --origins=${POCKETBASE_ALLOWED_ORIGINS}"]
