# PocketBase API base URL (browser build setting; public URL, not a secret).
# Example: https://your-pocketbase-service.liara.run
VITE_POCKETBASE_URL=
# Same PocketBase base URL for the Node ZIP import processor (runtime setting).
POCKETBASE_URL=

# Liara PostgreSQL DBaaS connection string (PG_URI is the usual Liara setting)
PG_URI=postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# DATABASE_URL is also accepted by the application.
# DATABASE_URL=
# Set true only when the /data/cars_database.json file is intentionally absent and a new empty catalogue is desired.
ALLOW_EMPTY_POSTGRES_BOOTSTRAP=false

# Set these in Liara's app environment variables; never commit real secrets.
# Use two distinct, private 4-digit PINs.
ADMIN_PIN=CHANGE_ME
COLLEAGUE_PIN=CHANGE_ME
# Generate a random secret of at least 32 characters (for example: openssl rand -base64 48).
SESSION_SECRET=REPLACE_WITH_RANDOM_SECRET_OF_32_CHARACTERS_OR_MORE

# Keep the Liara persistent disk mounted at /data.
PORT=3000
NODE_ENV=production
GEMINI_API_KEY=
APP_URL=
