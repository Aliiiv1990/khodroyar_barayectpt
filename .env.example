# Liara PostgreSQL DBaaS connection string (Liara's quick setup docs call this PG_URI)
# Set PG_URI in the Liara app's environment variables after creating a PostgreSQL database.
# PG_URI=postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# DATABASE_URL is also accepted for hosting providers using that convention.
# DATABASE_URL=

# Existing Liara Persistent Disk; keep the disk mounted at /data.
# Image files are externalized from PostgreSQL JSON records into /data/images.
PORT=3000
NODE_ENV=production
GEMINI_API_KEY=
APP_URL=
