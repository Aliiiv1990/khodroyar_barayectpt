# PocketBase public HTTPS address injected into the Vite browser build.
# Example: https://khodroyar-pocketbase.liara.run
VITE_POCKETBASE_URL=

# PocketBase private-network address used by the Node ZIP import worker.
# Example: http://khodroyar-pocketbase:8090
POCKETBASE_URL=

# Existing Node app settings
PORT=3000
NODE_ENV=production
APP_URL=https://carplus.liara.run
GEMINI_API_KEY=
